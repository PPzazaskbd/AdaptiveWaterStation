[Unit]
Description=Checkpoint MQTT to existing telemetry API
Wants=network-online.target
After=network-online.target embedded-backend.service

[Service]
Type=simple
User=embedded-backend
Group=embedded-backend
WorkingDirectory=/opt/embedded-mqtt-bridge
ExecStart=/usr/local/bin/node /opt/embedded-mqtt-bridge/bridge.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
